<!--
  Règles locales du lab — /var/ossec/etc/rules/local_rules.xml (manager)
  Plage d'IDs réservée aux règles locales : 100000-120000.
  Parents vérifiés dans le ruleset Wazuh 4.14 ; chaque règle reste À VALIDER avec
  /var/ossec/bin/wazuh-logtest avant déploiement.
-->

<group name="local,sysmon,">
  <!-- Sysmon EID 1 (parent natif 61603, niveau 0) : exécution de PowerShell.
       MITRE T1059.001. Idée reprise d'UsmanPrime (Sysmon EID 1 élevé au niveau 8). -->
  <rule id="100100" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <description>Sysmon : exécution de PowerShell sur $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>
</group>

<group name="local,suricata,">
  <!-- Suricata sur pfSense : les lignes EVE arrivent par syslog et sont décodées par notre
       décodeur « json » restreint (local_decoder.xml), puis par les natives 86600/86601. -->

  <!-- Suricata (parent natif 86601, niveau 3) : alertes de sévérité 1 (la plus haute).
       Ne couvre QUE la sévérité 1 : les signatures ET SCAN du scénario 4 (sévérité 2) n'y
       passent pas, d'où 100210. Pas de MITRE : dépend de la signature. Pas encore vue en action. -->
  <rule id="100200" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata (sévérité 1) : $(alert.signature)</description>
  </rule>

  <!-- Suricata : scan réseau détecté par signature ET SCAN (reconnaissance active). MITRE T1046.
       Validée en live le 2026-10-22 (scénario 4, docs/scenarios/suricata-nids.md). -->
  <rule id="100210" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)ET SCAN</field>
    <description>Suricata : scan réseau détecté - $(alert.signature)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,</group>
  </rule>
</group>

<group name="local,pfsense,">
  <!-- pfSense 2.9 : les règles natives 87700-87702 ne se déclenchent pas, car le pré-décodeur
       n'extrait pas program_name des lignes pfSense 2.9 (voir local_decoder.xml).
       Ces règles reprennent leur logique sur notre décodeur « pfsense-filterlog ». -->

  <!-- Base : toute ligne filterlog décodée (niveau 0, pas d'alerte). -->
  <rule id="100300" level="0">
    <decoded_as>pfsense-filterlog</decoded_as>
    <description>pfSense : événement filterlog</description>
  </rule>

  <!-- Trafic autorisé par une règle journalisée. Pas de technique MITRE (trafic légitime). -->
  <rule id="100301" level="3">
    <if_sid>100300</if_sid>
    <action>pass</action>
    <description>pfSense : trafic autorisé $(srcip) -> $(dstip) ($(protocol))</description>
  </rule>

  <!-- Paquet bloqué (équivalent de 87701). Volontairement SANS no_log, contrairement au natif :
       dans le lab, on veut voir chaque blocage. En production, ajouter
       <options>no_log</options> pour éviter le bruit. Pas de MITRE seul (bruit normal). -->
  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <action>block</action>
    <description>pfSense : paquet bloqué $(srcip) -> $(dstip) ($(protocol)) sur $(interface)</description>
    <group>firewall_block,</group>
  </rule>

  <!-- Rafale : 18 blocages depuis la même IP en 45 s (équivalent de 87702). Signe de scan de
       ports ou de balayage réseau : MITRE T1046 (Network Service Discovery). La règle native
       utilise T1110 (force brute). ignore=240 : silence de 4 min après déclenchement. -->
  <rule id="100303" level="10" frequency="18" timeframe="45" ignore="240">
    <if_matched_sid>100302</if_matched_sid>
    <same_source_ip />
    <description>pfSense : blocages répétés depuis $(srcip) (scan probable)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_blocks,</group>
  </rule>
</group>

<group name="local,windows,">
  <!-- Succès d'ouverture de session Windows peu après une rafale d'échecs (60204) depuis la
       même IP : le brute force a probablement abouti, le compte est compromis.
       Pourquoi une règle locale : la native 40112 (« Multiple authentication failures
       followed by a success ») compare srcip (same_source_ip), or les événements Windows
       portent l'IP dans win.eventdata.ipAddress, d'où notre same_field (déduction : 40112
       n'a jamais été vue dans le lab).
       - if_group authentication_success : tout succès Windows (60106 pour 4624 ; 92652 si
         elle porte ce groupe, à vérifier), même mécanisme que 40112.
       - if_matched_sid 60204 + same_field : une 60204 depuis la même IP dans les 240 s.
         240 s couvre aussi la levée du blocage de la réponse active (180 s).
       - ANONYMOUS LOGON exclu : sondage SMB sans compte, pas une compromission.
       MITRE ATT&CK : T1110 (Brute Force) abouti, puis T1078 (Valid Accounts).
       À VALIDER avec wazuh-logtest puis en rejouant le scénario (writeup 07, § 1.4). -->
  <rule id="100400" level="12" timeframe="240">
    <if_group>authentication_success</if_group>
    <if_matched_sid>60204</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <field name="win.eventdata.targetUserName" negate="yes">^ANONYMOUS LOGON$</field>
    <description>Windows : connexion réussie de $(win.eventdata.targetUserName) depuis $(win.eventdata.ipAddress) juste après une rafale d'échecs (brute force abouti probable)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>brute_force_success,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="sysmon,sysmon_event_10,">
  <!-- T1003.001 LSASS Memory : acces au processus lsass.exe (Sysmon Event 10). Enfant de 61612.
       Validée en live le 2026-10-25 (scénario 5). Complète la native 92900 (0945-sysmon_id_10.xml). -->
  <rule id="100220" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x1010|0x1410|0x1438|0x143a|0x1fffff</field>
    <description>Acces au processus LSASS par $(win.eventdata.sourceImage) - credential dumping possible (T1003.001)</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>
</group>

<group name="sysmon,windows,persistence,">
  <!-- Persistance par clé Run (Sysmon EID 13). MITRE T1547.001.
       La native 92300 (0860-sysmon_id_13.xml) reconnaît toute écriture dans
       …\CurrentVersion\Run mais reste au niveau 0 ; ses enfants 92301-92303 ne couvrent que
       .lnk/.vbs/.vba, reg.exe et VNC. On s'accroche SOUS 92300 : une règle sœur de 92300
       (if_sid 61615) n'est jamais évaluée, 92300 passant avant.
       Validée en live le 2026-10-25 (scénario 5b, docs/scenarios/persistance-run-key.md).
       Bruyant (installeurs légitimes) : liste blanche à prévoir en phase 2. -->
  <rule id="100230" level="12">
    <if_sid>92300</if_sid>
    <description>Persistance Run-key (T1547.001): $(win.eventdata.image) a ecrit $(win.eventdata.details) dans $(win.eventdata.targetObject)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>
</group>

<group name="sysmon,windows,">
  <!-- Liste blanche de 100230 : auto-démarrage de Microsoft Edge (bénin).
       Enfant de niveau 0 : quand l'écriture Run concerne MicrosoftEdgeAutoLaunch ou
       msedge_cleanup, l'événement s'arrête ici, sans alerte. Toute autre écriture Run garde
       l'alerte 100230 (niveau 12).
       Validée en live le 2026-10-28 (~22:30) : clé Edge → niveau 0 ; clé de test non Edge →
       100230 niveau 12. Voir docs/writeup/18-tuning-faux-positifs.md. -->
  <rule id="100231" level="0">
    <if_sid>100230</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(MicrosoftEdgeAutoLaunch|msedge_cleanup)</field>
    <description>Persistance Run-key : auto-demarrage Microsoft Edge connu (benin) - ignore</description>
  </rule>
</group>

<group name="lateral_movement,windows,">
  <!-- Mouvement latéral SMB depuis le segment d'attaque (événement Security 5140). MITRE T1021.002.
       Enfant de la native 67017 (0955-WEF-baseline_rules.xml, niveau 3, T1021.002 : accès à un
       partage réseau). On élève au niveau 12 quand la source est 10.10.20.0/24 : aucun trafic
       SMB légitime ne vient de ce segment dans le lab.
       Prérequis : audit « Partage de fichiers » (GUID 0CCE9224) en succès et échec.
       Validée en live le 2026-10-28 20:37 (scénario 6, docs/scenarios/mouvement-lateral-smb.md).
       Contenu reconstruit d'après la règle appliquée sur le manager et l'alerte observée.
       LIMITE : 67017 veut exclure IPC$ (negate "IPC$|NetLogon"), mais en OS_Regex `$` est
       l'ancre de fin : « IPC$ » ne correspond donc jamais à la valeur « \\*\IPC$ » et IPC$,
       touché à chaque connexion SMB, passe quand même (déduction cohérente avec l'alerte
       observée). Tuning proposé, à valider avec wazuh-logtest :
         <field name="win.eventdata.shareName" negate="yes">IPC\$</field> -->
  <rule id="100240" level="12">
    <if_sid>67017</if_sid>
    <field name="win.eventdata.ipAddress">^10\.10\.20\.</field>
    <description>Mouvement lateral SMB : acces a un partage depuis le segment d attaque ($(win.eventdata.ipAddress)) - compte $(win.eventdata.subjectUserName) - partage $(win.eventdata.shareName)</description>
    <mitre><id>T1021.002</id></mitre>
  </rule>
</group>

<group name="log_clearing,defense_evasion,windows,">
  <!-- Effacement du journal Security (événement 1102, fournisseur Microsoft-Windows-Eventlog).
       MITRE T1070.001 (Clear Windows Event Logs).
       Chaîne native : 60001 (canal Security) → 60017 (fournisseur Eventlog) → 63108 → 63103
       (0610-win-ms_logs_rules.xml, niveau 5, T1070 sans sous-technique). On élève au niveau 12 :
       effacer un journal d'audit est presque toujours malveillant ou au minimum à expliquer.
       Les champs du 1102 sont sous win.logFileCleared (et non win.eventdata).
       Validée en live le 2026-10-28 21:27 (scénario 7, docs/scenarios/effacement-journaux.md).
       Contenu reconstruit d'après la règle appliquée sur le manager et l'alerte observée. -->
  <rule id="100250" level="12">
    <if_sid>63103</if_sid>
    <description>Evasion defenses : journal d audit Windows efface par $(win.logFileCleared.subjectUserName) sur $(win.system.computer)</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>
</group>

<group name="local,sysmon,impact,">
  <!-- Scénario 8 : suppression des clichés instantanés, précurseur de rançongiciel. MITRE T1490
       (Inhibit System Recovery, tactique Impact). Aucune règle native du ruleset 4.14 ne vise
       cette commande (grep « vssadmin|delete…shadow » vide hors 0585, qui ne traite que des
       erreurs du service VSS dans le journal Application).
       Parent : 61603 (Sysmon EID 1, niveau 0). Variantes couvertes : vssadmin delete shadows,
       vssadmin resize shadowstorage, wmic shadowcopy delete, PowerShell Win32_ShadowCopy.
       Validée en live le 2026-10-29 14:36 (writeup 19). -->
  <rule id="100260" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)vssadmin.*(delete\s+shadows|resize\s+shadowstorage)|shadowcopy.*delete|win32_shadowcopy</field>
    <description>Suppression des clichés instantanés sur $(win.system.computer) (précurseur rançongiciel)</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>
</group>
