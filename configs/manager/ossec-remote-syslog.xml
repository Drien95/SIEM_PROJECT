<!--
  Extrait à insérer dans <ossec_config> de /var/ossec/etc/ossec.conf (manager).
  Réception du syslog pfSense. Remplacer l'IP par celle de pfSense côté réseau Wazuh.
  Puis : sudo systemctl restart wazuh-manager ; ouvrir 514/UDP sur la VM Wazuh.
-->
<remote>
  <connection>syslog</connection>
  <port>514</port>
  <protocol>udp</protocol>
  <allowed-ips>192.168.1.1</allowed-ips>
</remote>
