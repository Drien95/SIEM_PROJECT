<!--
  Règles locales du lab — /var/ossec/etc/rules/local_rules.xml (manager)
  Plage d'IDs réservée aux règles locales : 100000-120000.
  Parents vérifiés dans le ruleset Wazuh 4.14 ; chaque règle reste À VALIDER avec
  /var/ossec/bin/wazuh-logtest avant déploiement.
-->

<group name="local,sysmon,">
  <!-- Sysmon EID 1 (parent natif 61603, niveau 0) : exécution de PowerShell.
       MITRE T1059.001. Idée reprise d'UsmanPrime (Sysmon EID 1 élevé au niveau 8). -->
  <rule id="100100" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <description>Sysmon : exécution de PowerShell sur $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>
</group>

<group name="local,suricata,">
  <!-- Suricata (parent natif 86601, niveau 3) : alertes de sévérité 1 (la plus haute). -->
  <rule id="100200" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata (sévérité 1) : $(alert.signature)</description>
  </rule>
</group>

<group name="local,pfsense,">
  <!-- pfSense 2.9 : les règles natives 87700-87702 ne se déclenchent pas, car le pré-décodeur
       n'extrait pas program_name des lignes pfSense 2.9 (voir local_decoder.xml).
       Ces règles reprennent leur logique sur notre décodeur « pfsense-filterlog ». -->

  <!-- Base : toute ligne filterlog décodée (niveau 0, pas d'alerte). -->
  <rule id="100300" level="0">
    <decoded_as>pfsense-filterlog</decoded_as>
    <description>pfSense : événement filterlog</description>
  </rule>

  <!-- Trafic autorisé par une règle journalisée. Pas de technique MITRE (trafic légitime). -->
  <rule id="100301" level="3">
    <if_sid>100300</if_sid>
    <action>pass</action>
    <description>pfSense : trafic autorisé $(srcip) -> $(dstip) ($(protocol))</description>
  </rule>

  <!-- Paquet bloqué (équivalent de 87701). Volontairement SANS no_log, contrairement au natif :
       dans le lab, on veut voir chaque blocage. En production, ajouter
       <options>no_log</options> pour éviter le bruit. Pas de MITRE seul (bruit normal). -->
  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <action>block</action>
    <description>pfSense : paquet bloqué $(srcip) -> $(dstip) ($(protocol)) sur $(interface)</description>
    <group>firewall_block,</group>
  </rule>

  <!-- Rafale : 18 blocages depuis la même IP en 45 s (équivalent de 87702). Signe de scan de
       ports ou de balayage réseau : MITRE T1046 (Network Service Discovery). La règle native
       utilise T1110 (force brute). ignore=240 : silence de 4 min après déclenchement. -->
  <rule id="100303" level="10" frequency="18" timeframe="45" ignore="240">
    <if_matched_sid>100302</if_matched_sid>
    <same_source_ip />
    <description>pfSense : blocages répétés depuis $(srcip) (scan probable)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>multiple_blocks,</group>
  </rule>
</group>

<group name="local,windows,">
  <!-- Succès d'ouverture de session Windows peu après une rafale d'échecs (60204) depuis la
       même IP : le brute force a probablement abouti, le compte est compromis.
       Pourquoi une règle locale : la native 40112 (« Multiple authentication failures
       followed by a success ») compare srcip (same_source_ip), or les événements Windows
       portent l'IP dans win.eventdata.ipAddress, d'où notre same_field (déduction : 40112
       n'a jamais été vue dans le lab).
       - if_group authentication_success : tout succès Windows (60106 pour 4624 ; 92652 si
         elle porte ce groupe, à vérifier), même mécanisme que 40112.
       - if_matched_sid 60204 + same_field : une 60204 depuis la même IP dans les 240 s.
         240 s couvre aussi la levée du blocage de la réponse active (180 s).
       - ANONYMOUS LOGON exclu : sondage SMB sans compte, pas une compromission.
       MITRE ATT&CK : T1110 (Brute Force) abouti, puis T1078 (Valid Accounts).
       À VALIDER avec wazuh-logtest puis en rejouant le scénario (writeup 07, § 1.4). -->
  <rule id="100400" level="12" timeframe="240">
    <if_group>authentication_success</if_group>
    <if_matched_sid>60204</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <field name="win.eventdata.targetUserName" negate="yes">^ANONYMOUS LOGON$</field>
    <description>Windows : connexion réussie de $(win.eventdata.targetUserName) depuis $(win.eventdata.ipAddress) juste après une rafale d'échecs (brute force abouti probable)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>brute_force_success,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>
